<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ConversationActivity">

    <LinearLayout
        android:id="@+id/SourcetextInputLayout"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:background="@drawable/bg_style2"
        android:backgroundTint="@color/grey">

        <TextView
            android:layout_weight="1"
            android:id="@+id/sourceText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/colorPrimary"/>

        <ImageView
            android:layout_weight="1"
            android:id="@+id/sourceText_speaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/speaker"
            android:tint="@color/colorPrimary"
            android:layout_gravity="right"/>

    </LinearLayout>

    <LinearLayout
        android:layout_weight="1"
        android:id="@+id/TargettextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:background="@drawable/bg_style2"
        android:backgroundTint="@color/grey">

        <TextView
            android:layout_weight="1"
            android:id="@+id/targetText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/colorPrimary"/>

        <ImageView
            android:layout_weight="1"
            android:id="@+id/targetText_speaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/speaker"
            android:tint="@color/colorPrimary"
            android:layout_gravity="right"/>


    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/SourcetextInputLayout2"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:background="@drawable/bg_style2"
        android:backgroundTint="@color/grey">

        <TextView
            android:layout_weight="1"
            android:id="@+id/sourceText2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/colorPrimary"/>

        <ImageView
            android:layout_weight="1"
            android:id="@+id/sourceText_speaker2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/speaker"
            android:tint="@color/colorPrimary"
            android:layout_gravity="right"/>

    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:layout_weight="1"
        android:id="@+id/TargettextInputLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:background="@drawable/bg_style2"
        android:backgroundTint="@color/grey">

        <TextView
            android:layout_weight="1"
            android:id="@+id/targetText2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/colorPrimary"/>

        <ImageView
            android:layout_weight="1"
            android:id="@+id/targetText_speaker2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/speaker"
            android:tint="@color/colorPrimary"
            android:layout_gravity="right"/>

    </LinearLayout>

    <LinearLayout
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/sourceLangSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:textAlignment="center"
                android:background="@drawable/bg_style"
                android:backgroundTint="@color/grey"/>

            <ImageView
                android:id="@+id/sourceVoice"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="10dp"
                android:src="@drawable/ic_voice"
                android:tint="@color/white"
                android:layout_gravity="center"
                android:background="@drawable/circle"
                android:backgroundTint="@color/colorPrimary"/>

        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/targetLangSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:textAlignment="center"
                android:background="@drawable/bg_style"
                android:backgroundTint="@color/grey"/>

            <ImageView
                android:id="@+id/targetVoice"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="10dp"
                android:src="@drawable/ic_voice"
                android:tint="@color/white"
                android:layout_gravity="center"
                android:background="@drawable/circle"

                android:backgroundTint="@color/colorPrimary"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>